# Variáveis necessárias para correr a app (local e em produção/Vercel).
# Copia os VALORES a partir do teu .env.local — nunca os metas no git.

# --- Supabase (obrigatório) ---
# Usa SEMPRE a chave publicável (sb_publishable_...), NUNCA a service_role no frontend.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Lodgify (opcional: sincronizar reservas) ---
# Chave de API SÓ do lado do servidor (nunca NEXT_PUBLIC).
# Usada pela sincronização das casas com fonte 'lodgify_api'.
LODGIFY_API_KEY=

# --- TOConline (opcional: importar custos) ---
TOCONLINE_CLIENT_ID=
TOCONLINE_CLIENT_SECRET=
TOCONLINE_OAUTH_URL=
TOCONLINE_API_URL=
# Em produção tem de ser o domínio real, ex.:
#   https://<o-teu-dominio>/api/toconline/callback
# e o MESMO valor tem de estar gravado no TOConline (Empresa > Definições > Dados API).
TOCONLINE_REDIRECT_URL=
